# Use with the "REST Client" extension in VSCode (humao.rest-client).
# Click "Send Request" above each ### block, top to bottom.

@host = http://localhost:3000

### Register a new user
# @name register
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "alice@example.com", "password": "password123", "name": "Alice" }

### Log in
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "alice@example.com", "password": "password123" }

@token = {{login.response.body.token}}

### Who am I
GET {{host}}/auth/me
Authorization: Bearer {{token}}

### Create a team (default visibility is private)
# @name createTeam
POST {{host}}/teams
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Platform", "visibility": "private" }

@teamId = {{createTeam.response.body.id}}

### List my teams
GET {{host}}/teams
Authorization: Bearer {{token}}

### List public teams I have not joined yet
GET {{host}}/teams/public
Authorization: Bearer {{token}}

### Team detail + members
GET {{host}}/teams/{{teamId}}
Authorization: Bearer {{token}}

### Update a team
PATCH {{host}}/teams/{{teamId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Platform Team", "visibility": "public" }

### Add a member by email (manager or admin only)
POST {{host}}/teams/{{teamId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "bob@example.com", "role": "member" }

### Join a public team
POST {{host}}/teams/<public-team-id>/join
Authorization: Bearer {{token}}

### Create a note
# @name createNote
POST {{host}}/teams/{{teamId}}/notes
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Design doc", "content": "API layering", "tags": ["work", "design"], "pinned": true }

@noteId = {{createNote.response.body.id}}

### List notes (filters: ?q=text &tag=work &pinned=true)
GET {{host}}/teams/{{teamId}}/notes?q=design
Authorization: Bearer {{token}}

### List team tag values
GET {{host}}/teams/{{teamId}}/notes/tags
Authorization: Bearer {{token}}

### Get one note
GET {{host}}/teams/{{teamId}}/notes/{{noteId}}
Authorization: Bearer {{token}}

### Update a note (send only the fields to change)
PATCH {{host}}/teams/{{teamId}}/notes/{{noteId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "content": "Updated content" }

### Delete a note
DELETE {{host}}/teams/{{teamId}}/notes/{{noteId}}
Authorization: Bearer {{token}}

### List all teams as an admin
GET {{host}}/teams?all=true
Authorization: Bearer {{token}}

### Change a user's global role (admin only)
PATCH {{host}}/users/<user-id>/role
Authorization: Bearer {{token}}
Content-Type: application/json

{ "role": "admin" }
